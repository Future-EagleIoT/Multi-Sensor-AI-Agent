# Future Eagle IIoT SaaS — Localhost Environment (Zero AWS / Zero Cloudflare)
APP_ENV=development
APP_NAME=Future Eagle IIoT

# PostgreSQL + TimescaleDB + pgvector
POSTGRES_USER=eagle_admin
POSTGRES_PASSWORD=eagle_dev_password_change_me
POSTGRES_DB=future_eagle_saas
# Non-superuser role used by API (so PostgreSQL RLS is strictly enforced!)
APP_DB_USER=eagle_app
APP_DB_PASSWORD=eagle_app_password_change_me

# Valkey (Redis-compatible cache & cooldown store)
VALKEY_URL=redis://valkey:6379/0

# NATS JetStream
NATS_URL=nats://nats:4222

# EMQX MQTT Broker (mTLS)
EMQX_HOST=emqx
EMQX_PORT=8883
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=eagle_emqx_admin

# MinIO (Local S3-compatible object storage — swap to Hetzner/Scaleway/Backblaze B2 in prod)
MINIO_ROOT_USER=eagle_minio
MINIO_ROOT_PASSWORD=eagle_minio_secret_123
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET=future-eagle-artifacts

# Mailpit (Local SMTP catcher -> UI at http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=alerts@future-eagle.local

# Security / JWT
JWT_SECRET=dev_super_secret_jwt_key_change_in_production_32chars_min
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14

# Pluggable AI Diagnostic Copilot: mock | gemini | mistral | ollama
LLM_PROVIDER=mock
LLM_TEMPERATURE=0.15
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Public Local URLs
PUBLIC_APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:8081
